# Template for local development. Copy to .env and fill in.
# .env is gitignored; this file is not, so keep it free of real values.
#
#   cp .env.example .env
#
# In production these are set in the Render dashboard instead.

# Neon Postgres. Use the DIRECT (non-pooler) endpoint, with ?sslmode=require —
# migrations need session-level advisory locks the pooler does not support.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/coolors?sslmode=require

# Contents of config/master.key. Decrypts config/credentials.yml.enc.
RAILS_MASTER_KEY=

# Seeded admin account (db/seeds.rb). Sign-ups are disabled by design.
ADMIN_EMAIL=
ADMIN_PASSWORD=
